# Copy to apps/web/.env.local for local development, or .env for Docker Compose.
# Set a strong password before starting the service.
SAYSEED_PASSWORD=
# The data directory contains the database and the persistent encryption secret.
# Back up the entire directory together. Do not lose the secret file.
SAYSEED_DATA_DIR=./data
# Set this to the externally accessible HTTPS origin in production.
SAYSEED_PUBLIC_URL=http://localhost:3000
