{
  "name": "sayseed",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "dev": "pnpm --filter @sayseed/web dev",
    "dev:extension": "pnpm --filter @sayseed/extension dev",
    "build": "pnpm --filter @sayseed/web build && pnpm --filter @sayseed/extension build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm test:tooling && pnpm -r --if-present test",
    "test:tooling": "node --test scripts/*.test.mjs && python3 -m unittest discover -s scripts -p 'test_*.py'",
    "test:smoke": "node scripts/smoke.mjs",
    "test:ci": "node scripts/ci-smoke.mjs",
    "test:docker": "node scripts/docker-smoke.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "check:release": "node scripts/release-check.mjs",
    "package:extension": "python3 scripts/package-extension.py --output build/release/extension"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.1"
  }
}
